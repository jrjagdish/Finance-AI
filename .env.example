# Database
# Port 5433 (not 5432) because docker-compose maps the Postgres container there,
# to avoid clashing with a native Postgres install that may already own 5432.
DATABASE_URL=postgresql+psycopg2://finance:finance@localhost:5433/finance_ai

# Raw file storage (local dev fallback; S3/MinIO wired in a later milestone)
STORAGE_DIR=./storage

# App
APP_NAME=AI Finance Controller
DEBUG=true
DEFAULT_TENANT_ID=default

# Background jobs (Inngest) — replaces Celery/Redis so this runs on serverless
# hosts like Vercel's free tier. Local dev: run `inngest dev` (or the docker-compose
# `inngest` service) and set INNGEST_DEV=1 so the SDK targets it instead of the cloud.
# Production: leave INNGEST_DEV unset and fill in both keys from the Inngest dashboard.
INNGEST_DEV=1



# Groq (AI exception resolver) — leave blank to run with AI resolution disabled;
# unresolved records still land as exceptions for manual review (graceful degrade).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
